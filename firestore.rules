rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // 1. Global Safety Net Clear Block
    match /{document=**} {
      allow read, write: if false;
    }

    // Standard high-reliability helper macros
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // Object shape and data integrity checking for UserProfile model
    function isValidUserProfile(data) {
      return data.userId is string 
        && data.userId.size() <= 128
        && data.email is string
        && data.email.size() <= 256
        && data.displayName is string
        && data.displayName.size() <= 128
        && data.role is string
        && data.role in ['student', 'maker', 'admin']
        && (!('createdAt' in data) || data.createdAt == request.time)
        && (!('updatedAt' in data) || data.updatedAt == request.time);
    }

    // 2. Secured User Profiles collection match
    match /users/{userId} {
      allow get: if isSignedIn() && isOwner(userId);
      allow list: if false; // Forbid bulk data scraping or listing other users' records

      allow create: if isSignedIn() 
        && isOwner(userId) 
        && isValidId(userId)
        && incoming().userId == request.auth.uid
        && incoming().role in ['student', 'maker'] // Forbid registering as 'admin' to block privilege escalation
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time
        && isValidUserProfile(incoming())
        && incoming().keys().hasAll(['userId', 'email', 'displayName', 'role', 'createdAt', 'updatedAt']) 
        && incoming().keys().size() == 6;

      allow update: if isSignedIn() 
        && isOwner(userId) 
        && isValidId(userId)
        && isValidUserProfile(incoming())
        && incoming().userId == existing().userId
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && (
          // Action restriction: users can only change displayName or updates timestamps, not roles
          incoming().diff(existing()).affectedKeys().hasOnly(['displayName', 'updatedAt'])
        );

      allow delete: if false; // Users are prevented from self-destroying account traces directly
    }
  }
}
